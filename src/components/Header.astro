---
import { clinics, nav, email, socials } from "../data/site";
import ClinicButton from "./ClinicButton.astro";
import FutureLink from "./FutureLink.astro";
---
<header class="hdr" data-header>
  <div class="hdr__bar container">
    <a class="hdr__logo" href="#top" aria-label="Стоматологічна клініка Dr.Kopytko, на початок сторінки">
      <img src="img/logo-mark-96.webp" srcset="img/logo-mark-96.webp 96w, img/logo-mark-160.webp 160w" sizes="52px" width="96" height="74" alt="" />
      <span class="hdr__name">Dr.&nbsp;Kopytko<span class="hdr__sub">стоматологічна клініка</span></span>
    </a>

    <nav class="hdr__nav" aria-label="Розділи сторінки">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="hdr__phones" data-rec="R-001">
      {clinics.map((c, i) => (
        <>
          {i > 0 && <span class="hdr__sep" aria-hidden="true"></span>}
          <a class="hdr__phone" href={`tel:${c.phone}`}>
            <span class="hdr__street"><span class="visually-hidden">вул. </span>{c.street}</span>
            <span class="hdr__num">{c.phoneDisplay}</span>
          </a>
        </>
      ))}
    </div>

    <div class="hdr__actions" data-rec="R-001,R-016">
      <button class="hdr__btn hdr__btn--call" type="button" aria-expanded="false" aria-controls="call-panel" data-call-toggle>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
        <span>Зателефонувати</span>
      </button>
      <button class="hdr__btn hdr__btn--menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" fill="none"/></svg>
        <span>Меню</span>
      </button>
    </div>
  </div>

  <div class="call-panel" id="call-panel" hidden data-call-panel>
    <div class="container call-panel__inner">
      <p class="call-panel__title">Оберіть клініку</p>
      {clinics.map((c) => <ClinicButton clinic={c} rating={false} />)}
    </div>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Меню" hidden data-menu>
  <div class="menu__top container">
    <span class="menu__title">Меню</span>
    <button class="hdr__btn" type="button" data-menu-close>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" fill="none"/></svg>
      <span>Закрити</span>
    </button>
  </div>
  <div class="menu__body container">
    <nav aria-label="Розділи сторінки">
      <ul class="menu__nav">
        {nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="menu__clinics">
      {clinics.map((c) => <ClinicButton clinic={c} />)}
      <FutureLink note="Розділ у розробці" class="menu__future">Онлайн-запис</FutureLink>
    </div>
    <ul class="menu__contacts" data-rec="R-012,SM-R003,MA-R002">
      <li><a href={`mailto:${email}`}>{email}</a></li>
      {socials.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}
    </ul>
  </div>
</div>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: var(--line);
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: var(--header-h);
  }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 44px;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
  }
  .hdr__logo img { width: 52px; height: auto; }
  .hdr__name { display: grid; font-weight: 600; font-size: 1.0625rem; line-height: 1.1; }
  .hdr__sub { font-weight: 400; font-size: 0.8125rem; color: var(--color-text-muted); }

  .hdr__nav { display: none; margin-inline: auto; }
  .hdr__nav ul { display: flex; gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .hdr__nav a, .menu__nav a, .menu__contacts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .hdr__nav a { font-size: 1rem; }
  .hdr__nav a:hover, .menu__nav a:hover, .menu__contacts a:hover { text-decoration-line: underline; text-decoration-color: var(--color-primary); }

  .hdr__phones { display: none; align-items: center; gap: var(--s-2); margin-left: auto; }
  .hdr__sep { width: 1px; height: 32px; background: var(--color-border); }
  .hdr__phone {
    display: grid;
    min-height: 44px;
    align-content: center;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.2;
  }
  .hdr__street { font-size: 0.8125rem; color: var(--color-text-muted); }
  .hdr__num { font-weight: 600; font-size: 1rem; color: var(--color-text); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
  .hdr__phone:hover .hdr__num { color: var(--color-primary); text-decoration: underline; text-underline-offset: 4px; }

  .hdr__actions { display: none; gap: var(--s-1); margin-left: auto; }
  :global( .js) .hdr__actions { display: flex; }
  .hdr__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 44px;
    min-width: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-field-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .hdr__btn svg { flex: none; width: 20px; height: 20px; }
  .hdr__btn--call { border: 2px solid var(--color-primary); color: var(--color-primary); }
  .hdr__btn:hover { background: var(--color-surface); }
  .hdr__btn--call:hover, .hdr__btn--call[aria-expanded="true"] { background: var(--color-surface); color: var(--color-primary-hover); border-color: var(--color-primary-hover); }
  .hdr__btn:focus-visible, .hdr__phone:focus-visible, .hdr__logo:focus-visible, .hdr__nav a:focus-visible, .menu a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .call-panel { border-top: var(--line); background: var(--color-bg); }
  .call-panel__inner { display: grid; gap: var(--s-1); padding-block: var(--s-2) var(--s-3); }
  .call-panel__title { margin: 0; font-size: var(--fs-small); color: var(--color-text-muted); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-bg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[hidden] { display: none; }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); border-bottom: var(--line); }
  .menu__title { font-weight: 600; }
  .menu__body { display: grid; gap: var(--s-4); padding-block: var(--s-3) var(--s-6); }
  .menu__nav { list-style: none; margin: 0; padding: 0; display: grid; }
  .menu__nav li { border-bottom: var(--line); }
  .menu__nav a { font-family: var(--font-display); font-weight: 500; font-size: 1.75rem; width: 100%; min-height: 56px; }
  .menu__clinics { display: grid; gap: var(--s-1); justify-items: stretch; }
  .menu__clinics :global(.menu__future) { justify-self: start; min-height: 44px; color: var(--color-text-muted); }
  .menu__contacts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .menu__contacts a { color: var(--color-primary); text-decoration-line: underline; }

  /* tablet: phones visible, nav in the menu */
  @media (min-width: 768px) {
    .hdr__phones { display: flex; }
    .hdr__btn--call { display: none; }
    .hdr__actions { margin-left: 0; }
  }
  @media (max-width: 767px) {
    .hdr__sub { display: none; }
    .hdr__logo img { width: 44px; }
  }
  @media (max-width: 439px) {
    .hdr__name { display: none; }
  }
  @media (max-width: 359px) {
    .hdr__btn { padding: 0 8px; gap: 4px; font-size: 0.875rem; }
    .hdr__btn--call svg { display: none; }
  }
  /* desktop: full bar */
  @media (min-width: 1180px) {
    .hdr__nav { display: block; }
    .hdr__phones { margin-left: 0; }
    :global( .js) .hdr__actions { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hdr__btn { transition: none; }
  }
</style>
