---
// "Clinic button": street + real phone number (tel:) + Google rating of that clinic. The single primary action of the page.
import type { Clinic } from "../data/site";
interface Props { clinic: Clinic; tone?: "light" | "deep"; rating?: boolean; class?: string; rec?: string; }
const { clinic, tone = "light", rating = true, class: cls, rec = "R-001" } = Astro.props;
---
<a
  class:list={["clinic-btn", `clinic-btn--${tone}`, cls]}
  href={`tel:${clinic.phone}`}
  data-rec={rating ? `${rec},R-009` : rec}
>
  <span class="clinic-btn__street"><span class="visually-hidden">Зателефонувати в клініку на вул. </span>{clinic.street}</span>
  {rating && <span class="clinic-btn__rating">Google {clinic.rating} з 5, {clinic.reviews}</span>}
  <span class="clinic-btn__phone">{clinic.phoneDisplay}</span>
</a>

<style>
  .clinic-btn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "street rating" "phone phone";
    align-content: center;
    column-gap: var(--s-2);
    row-gap: 2px;
    min-height: 76px;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-on-primary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), transform 100ms var(--ease-out);
  }
  .clinic-btn__street { grid-area: street; font-size: 1rem; line-height: 1.3; }
  .clinic-btn__rating { grid-area: rating; font-size: var(--fs-small); line-height: 1.3; color: var(--color-on-primary); text-align: right; align-self: center; }
  .clinic-btn__phone {
    grid-area: phone;
    font-weight: 600;
    font-size: var(--fs-phone);
    line-height: 1.15;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .clinic-btn:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; transition: none; background: var(--color-primary-hover); }
  .clinic-btn:focus-visible .clinic-btn__phone { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .clinic-btn--deep { border: 1px solid var(--color-accent); }
  .clinic-btn--deep:focus-visible { outline-color: var(--color-accent); }
  .clinic-btn:active { transform: scale(.98); }
  @media (hover: hover) {
    .clinic-btn:hover { background: var(--color-primary-hover); }
    .clinic-btn:hover .clinic-btn__phone { transform: translateX(2px); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  }
  @media (max-width: 767px) {
    .clinic-btn { grid-template-areas: "street" "phone" "rating"; grid-template-columns: minmax(0, 1fr); padding: 12px var(--s-2); }
    .clinic-btn__rating { text-align: left; font-size: 0.875rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .clinic-btn:active { transform: none; }
    .clinic-btn:hover .clinic-btn__phone { transform: none; }
  }
</style>
